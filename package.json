{
  "name": "wechsel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small internal web app that makes it obvious when a teammate's PR is waiting for help.",
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "dev": "vite",
    "dev:node": "tsx watch src/server/platforms/node.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "preview": "wrangler dev",
    "start:node": "node dist/server/server/platforms/node.js",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute wechsel-db --local --file=./drizzle/0000_chunky_outlaw_kid.sql",
    "db:migrate:remote": "wrangler d1 execute wechsel-db --remote --file=./drizzle/0000_chunky_outlaw_kid.sql",
    "db:seed:local": "tsx src/server/db/seed-run.ts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/node-server": "^1.14.3",
    "@hono/zod-validator": "^0.9.0",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "dotenv": "^16.5.0",
    "hono": "^4.13.2",
    "lucide-react": "^1.31.0",
    "nanoid": "^6.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/workers-types": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
